        const val STATUS_FRESH = "fresh"
        const val STATUS_USED = "used"
        const val STATUS_FAILED = "failed"
        const val STATUS_INVALID = "invalid"

        // 🟢 Instagram / Meta sender hints
        private val META_SENDER_HINTS = listOf(
            "instagram.com",
            "mail.instagram.com",
            "no-reply@mail.instagram.com",
            "security@mail.instagram.com",
            "notification@mail.instagram.com",
            "facebookmail.com",
            "meta.com"
        )
    }

    data class Entry(
        val email: String,
        val password: String = "",
        val cookies: String = "",
        val refreshToken: String = "",
        val clientId: String = "",
        val recovery: String = "",
        val rawLine: String = "",
        var used: Boolean = false,
        var usedAt: Long = 0L,
        var lastStatus: String = "",
        var lastCheckedAt: Long = 0L
    ) {
        fun fullKey(): String {
            if (rawLine.isNotBlank() && rawLine.contains("|") && rawLine.contains("@")) return rawLine
            val sb = StringBuilder()
            sb.append(email)
            if (password.isNotBlank()) sb.append('|').append(password)
            if (refreshToken.isNotBlank()) sb.append('|').append(refreshToken)
            if (clientId.isNotBlank()) sb.append('|').append(clientId)
            if (recovery.isNotBlank()) sb.append('|').append(recovery)
            return sb.toString()
        }
    }

    data class MetaAccount(
        val phone: String,
        val password: String,
        val twofa: String,
        var used: Boolean = false
    )

    data class OtpResult(val success: Boolean, val otp: String = "", val rawText: String = "", val error: String = "")
