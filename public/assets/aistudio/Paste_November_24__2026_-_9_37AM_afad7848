    private suspend fun readAllFoldersSmart(entry: Entry): Pair<List<Map<String, String>>?, String> {
        if (entry.refreshToken.isNotBlank()) {
            val (msgs, err) = readAllMessagesViaDongvanApi(entry)
            if (msgs != null) return msgs to ""
            // fall through only if Dongvan failed hard; IMAP is disabled
            return null to err
        }
        if (entry.password.isNotBlank()) {
            return null to "No refresh token. IMAP disabled — add javax.mail dependency to enable password login."
        }
        return null to "No credentials"
    }

    private fun htmlToPlain(html: String): String {
        var s = html
        s = s.replace(Regex("(?is)<(script|style|head)[^>]*>.*?</\\1>"), " ")
        s = s.replace(Regex("(?i)<br\\s*/?>"), "\n")
        s = s.replace(Regex("<[^>]+>"), " ")
        s = Regex("&#(\\d+);").replace(s) { try { String(Character.toChars(it.groupValues[1].toInt())) } catch (_: Exception) { " " } }
        s = s.replace(Regex("[\\u200B-\\u200D\\uFEFF\\u00A0]"), " ")
        s = s.replace(Regex("[\\t\\x0B\\f\\r]+"), " ")
        return s.trim()
    }

    private fun extractMetaOtp(text: String): String {
        if (text.isBlank()) return ""
        val cleaned = htmlToPlain(text)
        val patterns = listOf(
            Regex("(?<!\\d)(\\d{5,8})(?!\\d)\\s+is\\s+your\\s+(?:Instagram|Meta|IG|Facebook)", RegexOption.IGNORE_CASE),
            Regex("(?:code|otp)\\s+(?:is|:)?\\s*(?<!\\d)(\\d{5,8})(?!\\d)", RegexOption.IGNORE_CASE),
            Regex("(?:IG|Instagram|Meta|Facebook)[^0-9]{0,80}(\\d{5,8})", RegexOption.IGNORE_CASE)
        )
        for (p in patterns) p.find(cleaned)?.let { return it.groupValues[1] }
        Regex("(?<!\\d)((?:\\d[\\s\\-]){4,7}\\d)(?!\\d)").findAll(cleaned).forEach { m ->
            val digits = m.value.replace(Regex("[\\s\\-]"), "")
            if (digits.length in 5..8) return digits
        }
        return ""
    }

    private fun isMetaMessage(msg: Map<String, String>): Boolean {
        val from = (msg["from"] ?: "").lowercase()
        val combined = "$from\n${msg["subject"]}\n${msg["preview"]}\n${msg["body"]}".lowercase()
        val isMetaSender = META_SENDER_HINTS.any { from.contains(it) }
        val hasMetaBody = (combined.contains("instagram") || combined.contains("meta") || combined.contains("facebook")) &&
                          (combined.contains("code") || combined.contains("verification") || combined.contains("security"))
        return isMetaSender || hasMetaBody
    }

    private fun analyzeMessages(messages: List<Map<String, String>>, triedPassword: String): CheckResult {
        if (messages.isEmpty()) return CheckResult(status = CheckStatus.FRESH, triedPassword = triedPassword)
        for (msg in messages) {
            if (isMetaMessage(msg)) {
                val preCode = (msg["code"] ?: "").trim()
                val otp = if (preCode.isNotEmpty()) preCode
                          else extractMetaOtp("${msg["from"]}\n${msg["subject"]}\n${msg["preview"]}\n${msg["body"]}")
                return CheckResult(CheckStatus.USED, otp, "", triedPassword, messages.size, messages.size)
            }
        }
        return CheckResult(CheckStatus.FRESH, "", "", triedPassword, messages.size, messages.size)
    }

    @Synchronized
    private fun readAll(): MutableList<Entry> {
        return try {
            val json = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(KEY_POOL, "[]") ?: "[]"
            val arr = JSONArray(json)
            val out = mutableListOf<Entry>()
            for (i in 0 until arr.length()) {
                val o = arr.optJSONObject(i) ?: continue
                val email = o.optString("email", "").trim()
                if (email.isNotEmpty()) {
                    out.add(Entry(
                        email, o.optString("password", "").trim(), o.optString("cookies", "").trim(),
                        o.optString("refreshToken", "").trim(), o.optString("clientId", "").trim(),
                        o.optString("recovery", "").trim(), o.optString("rawLine", "").trim(),
                        o.optBoolean("used", false), o.optLong("usedAt", 0L),
                        o.optString("lastStatus", "").trim(), o.optLong("lastCheckedAt", 0L)
                    ))
                }
            }
            out
        } catch (e: Exception) { mutableListOf() }
    }

    @Synchronized
    private fun writeAll(list: List<Entry>) {
        try {
            val arr = JSONArray()
            for (e in list) {
                val o = JSONObject()
                o.put("email", e.email); o.put("password", e.password); o.put("cookies", e.cookies)
                o.put("refreshToken", e.refreshToken); o.put("clientId", e.clientId); o.put("recovery", e.recovery)
                o.put("rawLine", e.rawLine); o.put("used", e.used); o.put("usedAt", e.usedAt)
                o.put("lastStatus", e.lastStatus); o.put("lastCheckedAt", e.lastCheckedAt)
                arr.put(o)
            }
            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(KEY_POOL, arr.toString()).apply()
        } catch (_: Exception) {}
    }

    fun getAllEntriesForCheck(): List<Entry> = readAll()

    fun getStats(): Triple<Int, Int, Int> {
        val list = readAll(); val total = list.size; val used = list.count { it.used }
        return Triple(total, total - used, used)
    }

    fun getStatsJson(): String {
        val list = readAll()
        val total = list.size
        val fresh = list.count { !it.used }
        val taken = list.count { it.used && it.lastStatus == STATUS_FRESH }
        val hasMsgs = list.count { it.used && it.lastStatus == STATUS_USED }
        val failed = list.count { it.used && it.lastStatus == STATUS_FAILED }
        val invalid = list.count { it.lastStatus == STATUS_INVALID }
        return """{"total":$total,"fresh":$fresh,"used":${taken + hasMsgs},"taken":$taken,"hasMsgs":$hasMsgs,"failed":$failed,"invalid":$invalid}"""
    }

    @Synchronized
    fun markUsed(email: String): Boolean {
        if (email.isBlank()) return false
        val list = readAll(); var changed = false
        for (e in list) {
            if (e.email.lowercase() == email.trim().lowercase() && !e.used) {
                e.used = true; e.usedAt = System.currentTimeMillis(); changed = true
            }
        }
        if (changed) writeAll(list)
        return changed
    }

    @Synchronized
    fun remove(email: String): Boolean {
        if (email.isBlank()) return false
        val list = readAll(); val before = list.size
        list.removeAll { it.email.lowercase() == email.trim().lowercase() }
        if (list.size < before) { writeAll(list); return true }
        return false
    }

    fun clearAll(): Boolean = try {
        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString(KEY_POOL, "[]").apply()
        context.getSharedPreferences(PREFS_SEEN, Context.MODE_PRIVATE).edit().clear().apply()
        true
    } catch (_: Exception) { false }

    fun getEntryByEmail(email: String): Entry? {
        val e = email.trim().lowercase()
        if (e.isEmpty()) return null
        return readAll().firstOrNull { it.email.lowercase() == e }
    }

    fun peekNextFresh(): String {
        val fresh = readAll().firstOrNull { !it.used }
        return fresh?.fullKey() ?: ""
    }

    fun getAllEmailsJson(): String {
        val arr = JSONArray()
        for (e in readAll()) {
            val o = JSONObject()
            o.put("email", e.email)
            o.put("password", e.password)
            o.put("used", e.used)
            o.put("usedAt", e.usedAt)
            o.put("rawLine", e.rawLine)
            o.put("lastStatus", e.lastStatus)
            o.put("lastCheckedAt", e.lastCheckedAt)
            arr.put(o)
        }
        return arr.toString()
    }

    @Synchronized
    fun resetAllUsed(): Boolean {
        val list = readAll(); var changed = false
        for (e in list) {
            if (e.used) {
                e.used = false; e.usedAt = 0L
                if (e.lastStatus == STATUS_FRESH) e.lastStatus = ""
                changed = true
            }
        }
        if (changed) writeAll(list)
        return true
    }

    @Synchronized
    fun markFresh(email: String): Boolean {
        if (email.isBlank()) return false
        val list = readAll(); var changed = false
        for (e in list) {
            if (e.email.lowercase() == email.trim().lowercase() && e.used) {
                e.used = false; e.usedAt = 0L
                if (e.lastStatus == STATUS_FRESH) e.lastStatus = ""
                changed = true
            }
        }
        if (changed) writeAll(list)
        return changed
    }

    fun isFresh(email: String): Boolean = getEntryByEmail(email)?.let { !it.used } ?: false

    fun getImapPasswordFor(email: String): String = getEntryByEmail(email)?.password ?: ""

    suspend fun testCredentials(email: String, password: String): Pair<Boolean, String> {
        return withContext(Dispatchers.IO) {
            try {
                // Without javax.mail, we can only test via Dongvan (needs refresh token)
                val entry = getEntryByEmail(email) ?: Entry(email = email, password = password)
                if (entry.refreshToken.isBlank()) {
                    return@withContext false to "IMAP disabled. Only refresh-token accounts can be tested."
                }
                val (messages, err) = readAllMessagesViaDongvanApi(entry)
                if (messages == null) false to (err.ifBlank { "Connection failed" })
                else true to "OK (${messages.size} messages)"
            } catch (e: Exception) { false to (e.message ?: "Error") }
        }
    }

    suspend fun checkForNewMessagesAndNotify(email: String) {
        withContext(Dispatchers.IO) {
            try {
                val entry = getEntryByEmail(email) ?: return@withContext
                val (messages, _) = readAllFoldersSmart(entry)
                Log.d(TAG, "checkForNewMessagesAndNotify: ${messages?.size ?: 0} msgs for $email")
            } catch (_: Exception) {}
        }
    }

    suspend fun addAndCheckFreshOnly(
        text: String,
        onProgress: (String, String) -> Unit = { _, _ -> }
    ): AddCheckResult = withContext(Dispatchers.IO) {
        val lines = text.replace("\r\n", "\n").split("\n").map { it.trim() }
            .filter { it.isNotEmpty() && !it.startsWith("#") }
        if (lines.isEmpty()) return@withContext AddCheckResult(0, 0, 0, 0, 0, 0)

        val currentList = readAll()
        val existingEmails = currentList.map { it.email.lowercase() }.toMutableSet()
        val validEntries = mutableListOf<Entry>()
        var deletedInvalid = 0

        for (line in lines) {
            val entry = parseAny(line)
            if (entry == null) { deletedInvalid++; onProgress("(invalid)", "invalid"); continue }
            if (entry.email.lowercase() in existingEmails) { onProgress(entry.email, "already_in_pool"); continue }
            if (entry.refreshToken.isBlank() && entry.password.isBlank()) {
                deletedInvalid++; onProgress(entry.email, "no_credentials"); continue
            }
            validEntries.add(entry)
        }

        var addedFresh = 0
        var markedUsed = 0
        var markedFailed = 0
        val keptEntries = currentList.toMutableList()
        val semaphore = Semaphore(5)
        val now = System.currentTimeMillis()

        coroutineScope {
            validEntries.map { entry ->
                async {
                    semaphore.withPermit {
                        onProgress(entry.email, "checking")
                        val result = try { checkMail(entry) }
                                     catch (_: Exception) { CheckResult(CheckStatus.NETWORK_ERROR) }
                        when (result.status) {
                            CheckStatus.FRESH -> {
                                synchronized(keptEntries) {
                                    keptEntries.add(entry.copy(
                                        used = false, usedAt = 0L,
                                        lastStatus = STATUS_FRESH, lastCheckedAt = now
                                    ))
                                    addedFresh++
                                }
                                onProgress(entry.email, "fresh")
                            }
                            CheckStatus.USED -> {
                                synchronized(keptEntries) {
                                    keptEntries.add(entry.copy(
                                        used = true, usedAt = now,
                                        lastStatus = STATUS_USED, lastCheckedAt = now
                                    ))
                                    markedUsed++
                                }
                                onProgress(entry.email, "used_kept")
                            }
                            else -> {
                                synchronized(keptEntries) {
                                    keptEntries.add(entry.copy(
                                        used = true, usedAt = now,
                                        lastStatus = STATUS_FAILED, lastCheckedAt = now
                                    ))
                                    markedFailed++
                                }
                                onProgress(entry.email, "failed_kept")
                            }
                        }
                    }
                }
            }.awaitAll()
        }

        writeAll(keptEntries)
        val (totalAfter, freshAfter, _) = getStats()
        AddCheckResult(
            addedFresh = addedFresh,
            deletedUsed = markedUsed,
            deletedInvalid = deletedInvalid,
            totalInput = lines.size,
            poolFresh = freshAfter,
            poolTotal = totalAfter,
            markedFailed = markedFailed
        )
    }

    suspend fun checkMail(entry: Entry): CheckResult {
        if (entry.email.isBlank()) return CheckResult(CheckStatus.INVALID_FORMAT)
        if (entry.refreshToken.isBlank() && entry.password.isBlank()) return CheckResult(CheckStatus.AUTH_FAILED)
        return withContext(Dispatchers.IO) {
            val (messages, readError) = readAllFoldersSmart(entry)
            if (messages == null) return@withContext CheckResult(CheckStatus.AUTH_FAILED, errorMessage = readError)
            analyzeMessages(messages, entry.password)
        }
    }

    fun getInstantFreshMail(): String {
        val list = readAll()
        val fresh = list.firstOrNull { !it.used }
        if (fresh != null) { markUsed(fresh.email); return fresh.fullKey() }
        return ""
    }

    suspend fun fetchOtp(email: String, passwordOverride: String = ""): OtpResult {
        return withContext(Dispatchers.IO) {
            val base = readAll().firstOrNull { it.email.lowercase() == email.trim().lowercase() }
                       ?: Entry(email = email, password = passwordOverride)
            val entry = base.copy(password = if (passwordOverride.isNotBlank()) passwordOverride else base.password)
            val (messages, err) = readAllFoldersSmart(entry)
            if (messages == null) return@withContext OtpResult(false, error = "Read failed: $err")
            if (messages.isEmpty()) return@withContext OtpResult(false, error = "No messages yet")
            for (msg in messages) {
                if (!isMetaMessage(msg)) continue
                val preCode = (msg["code"] ?: "").trim()
                val otp = if (preCode.isNotEmpty()) preCode
                          else extractMetaOtp("${msg["from"]}\n${msg["subject"]}\n${msg["preview"]}\n${msg["body"]}")
                if (otp.isNotEmpty()) return@withContext OtpResult(true, otp = otp)
            }
            OtpResult(false, error = "No OTP found")
        }
    }

    suspend fun reCheckFailedEntries(
        onProgress: (String, String) -> Unit = { _, _ -> }
    ): AddCheckResult = withContext(Dispatchers.IO) {
        val currentList = readAll()
        val failedEntries = currentList.filter { it.lastStatus == STATUS_FAILED }
        if (failedEntries.isEmpty()) {
            val (total, fresh, _) = getStats()
            return@withContext AddCheckResult(0, 0, 0, 0, fresh, total, 0)
        }

        var recoveredFresh = 0
        var stillFailed = 0
        val keptEntries = currentList.toMutableList()
        val semaphore = Semaphore(5)
        val now = System.currentTimeMillis()

        coroutineScope {
            failedEntries.map { entry ->
                async {
                    semaphore.withPermit {
                        onProgress(entry.email, "checking")
                        val result = try { checkMail(entry) }
                                     catch (_: Exception) { CheckResult(CheckStatus.NETWORK_ERROR) }
                        synchronized(keptEntries) {
                            val idx = keptEntries.indexOfFirst { it.email.lowercase() == entry.email.lowercase() }
                            if (idx >= 0) {
                                when (result.status) {
                                    CheckStatus.FRESH -> {
                                        keptEntries[idx] = keptEntries[idx].copy(
                                            used = false, usedAt = 0L,
                                            lastStatus = STATUS_FRESH, lastCheckedAt = now
                                        )
                                        recoveredFresh++
                                        onProgress(entry.email, "fresh")
                                    }
                                    CheckStatus.USED -> {
                                        keptEntries[idx] = keptEntries[idx].copy(
                                            used = true, usedAt = now,
                                            lastStatus = STATUS_USED, lastCheckedAt = now
                                        )
                                        stillFailed++
                                        onProgress(entry.email, "used_kept")
                                    }
                                    else -> {
                                        keptEntries[idx] = keptEntries[idx].copy(
                                            lastStatus = STATUS_FAILED, lastCheckedAt = now
                                        )
                                        stillFailed++
                                        onProgress(entry.email, "failed_kept")
                                    }
                                }
                            }
                        }
                    }
                }
            }.awaitAll()
        }

        writeAll(keptEntries)
        val (totalAfter, freshAfter, _) = getStats()
        AddCheckResult(recoveredFresh, 0, 0, failedEntries.size, freshAfter, totalAfter, stillFailed)
    }

    fun getFreshEntries(): List<Entry> = readAll().filter { !it.used }
    fun getUsedEntries(): List<Entry> = readAll().filter { it.used && it.lastStatus == STATUS_USED }
    fun getFailedEntries(): List<Entry> = readAll().filter { it.lastStatus == STATUS_FAILED }
}