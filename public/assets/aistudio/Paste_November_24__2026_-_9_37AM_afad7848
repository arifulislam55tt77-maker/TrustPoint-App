        return arr.toString()
    }

    private fun readMetaPool(): MutableList<MetaAccount> {
        return try {
            val json = context.getSharedPreferences(META_PREFS, Context.MODE_PRIVATE).getString(KEY_META_POOL, "[]") ?: "[]"
            val arr = JSONArray(json)
            val out = mutableListOf<MetaAccount>()
            for (i in 0 until arr.length()) {
                val o = arr.getJSONObject(i)
                out.add(MetaAccount(
                    o.optString("phone", ""),
                    o.optString("password", ""),
                    o.optString("twofa", ""),
                    o.optBoolean("used", false)
                ))
            }
            out
        } catch (e: Exception) { mutableListOf() }
    }

    private fun writeMetaPool(list: List<MetaAccount>) {
        try {
            val arr = JSONArray()
            for (e in list) {
                val o = JSONObject()
                o.put("phone", e.phone)
                o.put("password", e.password)
                o.put("twofa", e.twofa)
                o.put("used", e.used)
                arr.put(o)
            }
            context.getSharedPreferences(META_PREFS, Context.MODE_PRIVATE).edit().putString(KEY_META_POOL, arr.toString()).apply()
        } catch (_: Exception) {}
    }

    // ═══════════ PARSING & MAIL METHODS ═══════════

    fun parseAny(line: String): Entry? {
        if (line.isBlank()) return null
        return if (line.contains('|')) parsePipeLine(line) else parseColonLine(line)
    }

    private fun parsePipeLine(line: String): Entry? {
        val original = line.trim(); if (original.isEmpty()) return null
        val parts = original.split("|").map { it.trim() }
        val emailIdx = parts.indexOfFirst { isValidEmail(it) }; if (emailIdx < 0) return null
        val email = parts[emailIdx]
        val candidates = mutableListOf<String>(); var recovery = ""
        for ((i, p) in parts.withIndex()) {
            if (i == emailIdx || p.isBlank()) continue
            if (isValidEmail(p)) { if (recovery.isEmpty()) recovery = p; continue }
            candidates.add(p)
        }
        val refreshToken = candidates.firstOrNull { isRefreshToken(it) } ?: ""
        val clientId = candidates.firstOrNull { UUID_REGEX.matches(it) } ?: DEFAULT_DONGVAN_CLIENT_ID
        val others = candidates.filter { it != refreshToken && it != clientId }
        val password = others.getOrNull(0) ?: ""
        val extras = if (others.size > 1) others.subList(1, others.size).joinToString(EXTRA_SEP) else ""
        return Entry(email, password, extras, refreshToken, clientId, recovery, original)
    }

    private fun parseColonLine(line: String): Entry? {
        val original = line.trim(); if (original.isEmpty()) return null
        val parts = original.split(":").map { it.trim() }
        val emailIdx = parts.indexOfFirst { isValidEmail(it) }; if (emailIdx < 0) return null
        val email = parts[emailIdx]
        val candidates = mutableListOf<String>(); var recovery = ""
        for ((i, p) in parts.withIndex()) {
            if (i == emailIdx || p.isBlank()) continue
            if (isValidEmail(p)) { if (recovery.isEmpty()) recovery = p; continue }
            candidates.add(p)
        }
        val refreshToken = candidates.firstOrNull { isRefreshToken(it) } ?: ""
        val clientId = candidates.firstOrNull { UUID_REGEX.matches(it) } ?: DEFAULT_DONGVAN_CLIENT_ID
        val others = candidates.filter { it != refreshToken && it != clientId }
        return Entry(email, others.getOrNull(0) ?: "", "", refreshToken, clientId, recovery, original)
    }

    private fun isValidEmail(s: String): Boolean = s.isNotEmpty() && s.length <= 200 && EMAIL_REGEX.matches(s)

    private fun isRefreshToken(s: String): Boolean {
        if (s.length < 30) return false
        return s.startsWith("M.C") || s.startsWith("M.R") || s.startsWith("0.A") ||
               s.startsWith("OAQ") || s.startsWith("AwAB") || s.startsWith("EwA") ||
               s.startsWith("EwB") || s.startsWith("1.A") || s.length > 300
    }

    // ═══════════ DONGVAN API (no javax.mail needed) ═══════════

    private suspend fun readAllMessagesViaDongvanApi(entry: Entry): Pair<List<Map<String, String>>?, String> =
        withContext(Dispatchers.IO) {
            if (entry.refreshToken.isBlank()) return@withContext null to "No refresh token"
            var conn: HttpURLConnection? = null
            try {
                conn = (URL(DONGVAN_API_URL).openConnection() as HttpURLConnection).apply {
                    requestMethod = "POST"; doOutput = true
                    connectTimeout = TIMEOUT_MS; readTimeout = TIMEOUT_MS
                    setRequestProperty("Content-Type", "application/json")
                    setRequestProperty("Accept", "application/json")
                    setRequestProperty("Origin", "https://dongvanfb.net")
                    setRequestProperty("Referer", DONGVAN_REFERER)
                    setRequestProperty("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36")
                    setRequestProperty("x-requested-with", "mark.via.gp")
                }
                val clientId = entry.clientId.ifBlank { DEFAULT_DONGVAN_CLIENT_ID }
                val payload = JSONObject().apply {
                    put("email", entry.email); put("pass", entry.password)
                    put("refresh_token", entry.refreshToken); put("client_id", clientId)
                }
                OutputStreamWriter(conn.outputStream, Charsets.UTF_8).use { it.write(payload.toString()) }
                val code = conn.responseCode
                val stream = if (code in 200..299) conn.inputStream else conn.errorStream
                val body = stream?.let { BufferedReader(it.reader(Charsets.UTF_8)).use { r -> r.readText() } } ?: ""
                if (code != 200) return@withContext null to "Dongvan HTTP $code"
                val j = JSONObject(body)
                if (!j.optBoolean("status", false)) return@withContext null to "Dongvan: ${j.optString("content", "API error")}"
                val arr = j.optJSONArray("messages") ?: JSONArray()
                val out = mutableListOf<Map<String, String>>()
                for (i in 0 until arr.length()) {
                    val m = arr.optJSONObject(i) ?: continue
                    val from = m.optString("from", ""); val subject = m.optString("subject", "")
                    val msgBody = m.optString("message", ""); val preCode = m.optString("code", "")
                    val dateStr = m.optString("date", "")
                    val idHash = "$from|$subject|$dateStr|${msgBody.take(80)}".hashCode()
                    out.add(mapOf(
                        "id" to idHash.toString(), "subject" to subject, "from" to from,
                        "body" to msgBody, "preview" to htmlToPlain(msgBody).take(200),
                        "receivedDateTime" to dateStr, "receivedTimeMs" to "0", "code" to preCode
                    ))
                }
                return@withContext out to ""
            } catch (e: Exception) { return@withContext null to (e.message ?: "Network error") }
            finally { try { conn?.disconnect() } catch (_: Exception) {} }
        }

