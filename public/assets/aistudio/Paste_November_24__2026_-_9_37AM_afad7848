    // ═══════════ META POOL METHODS ═══════════

    @Synchronized
    fun addMetaAccounts(text: String): Triple<Int, Int, Int> {
        val lines = text.replace("\r\n", "\n").split("\n").map { it.trim() }.filter { it.isNotEmpty() && !it.startsWith("#") }
        if (lines.isEmpty()) return Triple(0, 0, 0)

        val current = readMetaPool().toMutableList()
        var added = 0

        for (line in lines) {
            val parts = line.split(Regex("\\s+"))
            if (parts.size >= 2) {
                val phone = parts[0].trim()
                val pass = parts[1].trim()
                val twofa = if (parts.size >= 3) parts[2].trim() else ""
                if (current.none { it.phone == phone }) {
                    current.add(MetaAccount(phone, pass, twofa))
                    added++
                }
            }
        }
        writeMetaPool(current)
        val fresh = current.count { !it.used }
        return Triple(added, fresh, current.size)
    }

    @Synchronized
    fun getNextMetaAccount(): MetaAccount? {
        val current = readMetaPool()
        val next = current.firstOrNull { !it.used }
        if (next != null) {
            next.used = true
            writeMetaPool(current)
            return next
        }
        return null
    }

    @Synchronized
    fun getMetaStats(): String {
        val current = readMetaPool()
        val total = current.size
        val fresh = current.count { !it.used }
        val used = total - fresh
        return """{"total":$total,"fresh":$fresh,"used":$used}"""
    }

    @Synchronized
    fun clearMetaPool() {
        context.getSharedPreferences(META_PREFS, Context.MODE_PRIVATE).edit().remove(KEY_META_POOL).apply()
    }

    @Synchronized
    fun saveMetaAccountsList(list: List<String>) {
        val current = readMetaPool()
        for (line in list) {
            val parts = line.split(Regex("\\s+"))
            if (parts.size >= 2) {
                val phone = parts[0].trim()
                val pass = parts[1].trim()
                val twofa = if (parts.size >= 3) parts[2].trim() else ""
                if (current.none { it.phone == phone }) {
                    current.add(MetaAccount(phone, pass, twofa))
                }
            }
        }
        writeMetaPool(current)
    }

    @Synchronized
    fun getMetaAccountsListRaw(): String {
        val current = readMetaPool()
        val arr = JSONArray()
        for (acc in current) {
            if (!acc.used) {
                arr.put("${acc.phone} ${acc.password} ${acc.twofa}".trim())
            }
