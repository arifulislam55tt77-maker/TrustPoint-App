}

private fun MainActivity.safeEvalJs(
    webView: WebView?,
    script: String,
    callback: ValueCallback<String>? = null
) {
    if (!isActivityAlive() || webView == null) return
    val runOnUi = {
        if (isActivityAlive()) {
            try {
                webView.evaluateJavascript(script, callback)
            } catch (_: Exception) {}
        }
    }
    if (Looper.myLooper() == Looper.getMainLooper()) {
        runOnUi()
    } else {
        try {
            runOnUiThread(runOnUi)
        } catch (_: Exception) {}
    }
}

private fun escapeForSingleQuotedJs(input: String): String {
    return input
        .replace("\\", "\\\\")
        .replace("'", "\\'")
        .replace("\r", "\\r")
        .replace("\n", "\\n")
        .replace("</script>", "<\\/script>", ignoreCase = true)
}

// ============================================================================
//  SAFE FILE / PICTURE CHOOSER (PREVENTS UPLOAD CRASHES)
// ============================================================================
internal fun MainActivity.launchSafeFileChooser(
    callback: ValueCallback<Array<Uri>>?,
    params: WebChromeClient.FileChooserParams?,
    isMainWebView: Boolean
): Boolean {
    if (!isActivityAlive()) {
        try { callback?.onReceiveValue(null) } catch (_: Exception) {}
        return false
    }

    if (WebState.fileChooserOpening) {
        try { callback?.onReceiveValue(null) } catch (_: Exception) {}
        return false
    }
    WebState.fileChooserOpening = true
    mainHandler.postDelayed({ WebState.fileChooserOpening = false }, 1200)

    return try {
        if (isMainWebView) {
            try { filePathCallback?.onReceiveValue(null) } catch (_: Exception) {}
            filePathCallback = callback
        } else {
            try { nativeFilePathCallback?.onReceiveValue(null) } catch (_: Exception) {}
            nativeFilePathCallback = callback
        }

        val acceptTypes = params?.acceptTypes
            ?.map { it.trim() }
            ?.filter { it.isNotEmpty() }
            ?.distinct()
            ?.toTypedArray()
            ?: emptyArray()

        val primaryMime = when {
            acceptTypes.isEmpty() -> "image/*"
            acceptTypes.size == 1 && acceptTypes[0].contains("/") -> acceptTypes[0]
            else -> "*/*"
        }

        val getContentIntent = Intent(Intent.ACTION_GET_CONTENT).apply {
            addCategory(Intent.CATEGORY_OPENABLE)
            type = primaryMime
            if (acceptTypes.size > 1) {
                putExtra(Intent.EXTRA_MIME_TYPES, acceptTypes)
            }
            if (params?.mode == WebChromeClient.FileChooserParams.MODE_OPEN_MULTIPLE) {
                putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true)
            }
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        }

        val chooserIntent = Intent.createChooser(getContentIntent, "Select File").apply {
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        }

        val reqCode = if (isMainWebView) {
            MainActivity.FILE_CHOOSER_REQUEST_CODE
        } else {
            MainActivity.NATIVE_FILE_CHOOSER_REQUEST_CODE
        }

        @Suppress("DEPRECATION")
        startActivityForResult(chooserIntent, reqCode)
        true
    } catch (e: Exception) {
        Log.e(MainActivity.TAG, "launchSafeFileChooser error: ${e.message}")
        WebState.fileChooserOpening = false
        try { callback?.onReceiveValue(null) } catch (_: Exception) {}
        if (isMainWebView) filePathCallback = null else nativeFilePathCallback = null
        false
    }
}

