internal fun MainActivity.clearBrowserWeb() {
    runOnUiThread {
        if (!isActivityAlive()) return@runOnUiThread
        try {
            isProxyToggling = false
            proxyConnectionFailed = false

            val tgUrl = try { WebState.telegramPopupWebView?.url } catch (_: Exception) { null }
            if (!tgUrl.isNullOrBlank() && tgUrl.contains("telegram.org")) {
                persistTelegramSessionState(tgUrl)
            } else {
                try { CookieManager.getInstance().flush() } catch (_: Exception) {}
            }

            try { findViewById<View>(android.R.id.content)?.setBackgroundColor(Color.BLACK) } catch (_: Exception) {}

            clearProxyOverride {
                if (!isActivityAlive()) return@clearProxyOverride
                try {
                    val oldProfile = getPage2ProfileName()

                    if (isBrowserWebViewReady()) {
                        try {
                            val parent = this.browserWebView.parent as? ViewGroup
                            parent?.removeView(this.browserWebView)
                            try {
                                this.browserWebView.stopLoading()
                                this.browserWebView.loadUrl("about:blank")
                                this.browserWebView.clearCache(true)
                                this.browserWebView.clearHistory()
                                this.browserWebView.clearFormData()
                                this.browserWebView.clearSslPreferences()
                                this.browserWebView.removeAllViews()
                            } catch (_: Exception) {}
                            this.browserWebView.destroy()
                        } catch (e: Exception) {
                            Log.e(MainActivity.TAG, "WebView destroy error: ${e.message}")
                        }
                    }

                    clearNonTelegramCookies(try { CookieManager.getInstance() } catch (_: Exception) { null })
                    clearBrowserCookies(oldProfile)
                    regeneratePage2ProfileName()

                    initBrowserWebView(true)

                    if (isBrowserModeOpen && isBrowserWebViewReady()) {
                        this.browserWebView.visibility = View.VISIBLE
                        this.browserWebView.setBackgroundColor(Color.BLACK)
                    }

                    if (isBrowserWebViewReady()) {
                        this.browserWebView.loadUrl(getPage2DefaultUrl())
                    }
                    bringTelegramFabToFront()

                    if (isBrowserModeOpen) {
                        mainHandler.postDelayed({ if (isActivityAlive()) sendBrowserWebBounds() }, 250)
                        mainHandler.postDelayed({ if (isActivityAlive()) sendBrowserWebBounds() }, 900)
                    }

                    toast("✓ Page 2 cleared")
                } catch (e: Exception) {
                    Log.e(MainActivity.TAG, "clearBrowserWeb inner error: ${e.message}")
                    toast("Clear error: ${e.message}")
                }
            }
        } catch (e: Exception) {
            Log.e(MainActivity.TAG, "clearBrowserWeb outer error: ${e.message}")
            toast("Clear error: ${e.message}")
        }
    }
}

internal fun MainActivity.clearBrowserCookies(oldProfileName: String) {
    if (oldProfileName.isBlank() || oldProfileName == "tp_telegram_persistent_profile") return
    if (Looper.myLooper() != Looper.getMainLooper()) {
        try {
            runOnUiThread { clearBrowserCookies(oldProfileName) }
        } catch (_: Exception) {}
        return
    }
    try {
        if (WebViewFeature.isFeatureSupported(WebViewFeature.MULTI_PROFILE)) {
            try {
                ProfileStore.getInstance().getProfile(oldProfileName)?.let { profile ->
                    profile.cookieManager.removeAllCookies(null)
                }
            } catch (_: Exception) {}
            try {
                ProfileStore.getInstance().deleteProfile(oldProfileName)
            } catch (_: Exception) {}
        }
    } catch (_: Exception) {}
}

