internal fun MainActivity.setNativeDarkMode(enabled: Boolean) {
    if (!isActivityAlive()) return
    darkModeEnabled = enabled
    try { getSharedPreferences(MainActivity.THEME_PREFS, Context.MODE_PRIVATE).edit().putBoolean(MainActivity.KEY_DARK_MODE, enabled).apply() } catch (_: Exception) {}

    applyForceDark(enabled)
    applyThemeColors(enabled)
    registerDarkModeDocumentStartScript()

    val nativeWv = nativeWebViewOrNull()
    try { nativeWv?.setBackgroundColor(Color.BLACK) } catch (_: Exception) {}
    if (isBrowserWebViewReady()) {
        try { this.browserWebView.setBackgroundColor(Color.BLACK) } catch (_: Exception) {}
        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
                this.browserWebView.settings.isAlgorithmicDarkeningAllowed = enabled
            } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                @Suppress("DEPRECATION")
                this.browserWebView.settings.forceDark = if (enabled) WebSettings.FORCE_DARK_ON else WebSettings.FORCE_DARK_OFF
            }
        } catch (_: Throwable) {}
    }

    try { CookieManager.getInstance().flush() } catch (_: Exception) {}

    if (enabled) {
        if (nativeWv != null) safeEvalJs(nativeWv, earlyDarkJs())
        try { injectDarkModeToBrowser(true) } catch (_: Exception) {}
    } else {
        mainHandler.postDelayed({
            val delayedNativeWv = nativeWebViewOrNull()
            if (isActivityAlive() && delayedNativeWv != null) {
                try { delayedNativeWv.reload() } catch (_: Exception) {}
            }
        }, 200)
        try { injectDarkModeToBrowser(false) } catch (_: Exception) {}
    }
    bringTelegramFabToFront()
}

internal fun MainActivity.injectDarkModeToBrowser(enabled: Boolean) {
    if (!isBrowserWebViewReady()) return
    try {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            this.browserWebView.settings.isAlgorithmicDarkeningAllowed = enabled
        } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            @Suppress("DEPRECATION")
            this.browserWebView.settings.forceDark = if (enabled) WebSettings.FORCE_DARK_ON else WebSettings.FORCE_DARK_OFF
        }
    } catch (_: Throwable) {}
}

internal fun MainActivity.applyThemeColors(dark: Boolean) {
    val webColor = Color.BLACK
    try {
        mainWebViewOrNull()?.setBackgroundColor(webColor)
        val nativeWv = nativeWebViewOrNull()
        if (nativeWv != null) {
            nativeWv.setBackgroundColor(webColor)
            (nativeWv.parent as? View)?.setBackgroundColor(Color.BLACK)
        }
        if (isBrowserWebViewReady()) {
            this.browserWebView.setBackgroundColor(webColor)
        }
        findViewById<View>(android.R.id.content)?.setBackgroundColor(Color.BLACK)
        window.decorView.setBackgroundColor(Color.BLACK)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            @Suppress("DEPRECATION")
            window.statusBarColor = Color.BLACK
            @Suppress("DEPRECATION")
            window.navigationBarColor = Color.BLACK
        }
    } catch (_: Exception) {}
}

@Suppress("DEPRECATION")
internal fun MainActivity.applyForceDark(enabled: Boolean) {
    val nativeWv = nativeWebViewOrNull() ?: return
    try {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            try { nativeWv.settings.isAlgorithmicDarkeningAllowed = enabled } catch (_: Throwable) {}
        } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            nativeWv.settings.forceDark = if (enabled) WebSettings.FORCE_DARK_ON else WebSettings.FORCE_DARK_OFF
        }
    } catch (_: Throwable) {}
}

internal fun MainActivity.registerDarkModeDocumentStartScript() {
    val nativeWv = nativeWebViewOrNull() ?: return
    if (!WebViewFeature.isFeatureSupported(WebViewFeature.DOCUMENT_START_SCRIPT)) return
    try {
        try { darkScriptHandler?.remove() } catch (_: Exception) {}
        darkScriptHandler = null
        val shouldDark = darkModeEnabled
        val js = """
            (function(){
                try {
                    var DARK = $shouldDark;
                    if (!DARK) return;
                    try {
                        var meta = document.querySelector('meta[name="color-scheme"]');
                        if (!meta) { 
                            meta = document.createElement('meta'); 
                            meta.name = 'color-scheme'; 
                            (document.head || document.documentElement).appendChild(meta); 
                        }
                        meta.content = 'dark';
                    } catch(e){}
                } catch(e){}
            })();
        """.trimIndent()
        darkScriptHandler = WebViewCompat.addDocumentStartJavaScript(nativeWv, js, setOf("*"))
    } catch (_: Exception) {}
}

internal fun MainActivity.earlyDarkJs(): String = """
    (function(){
        try {
            if (document.getElementById('tp-early-dark-style')) return;
            var css = 'html,body{background:#000 !important;color:#e5e7eb !important;}';
            var s = document.createElement('style');
            s.id = 'tp-early-dark-style';
            s.textContent = css;
            (document.head || document.documentElement).appendChild(s);
        } catch(e){}
    })();
""".trimIndent()

internal fun MainActivity.injectDarkModeCss(enabled: Boolean) {
    val nativeWv = nativeWebViewOrNull() ?: return
    if (!enabled) {
        safeEvalJs(
            nativeWv,
            "(function(){try{" +
            "var s=document.getElementById('tp-dark-style');" +
            "if(s&&s.parentNode)s.parentNode.removeChild(s);" +
            "}catch(e){}})();"
        )
        return
    }
    val js = """
        (function(){
            try {
                if (document.getElementById('tp-dark-style')) return;
                var css = '' +
                    'html{background:#000 !important;color-scheme:dark !important;}' +
                    'body{background:#000 !important;color:#e5e7eb !important;}' +
                    'a{color:#60a5fa !important;}' +
                    'input,textarea,select{background:#111 !important;color:#e5e7eb !important;border-color:#333 !important;}' +
                    'button{color-scheme:dark !important;}';
                var s = document.createElement('style');
                s.id = 'tp-dark-style';
                s.textContent = css;
                (document.head || document.documentElement).appendChild(s);
            } catch(e){}
        })();
    """.trimIndent()
    safeEvalJs(nativeWv, js)
}

