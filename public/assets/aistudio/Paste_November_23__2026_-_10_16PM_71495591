internal fun MainActivity.fixSnackbarStyle() {
    val mainWv = mainWebViewOrNull() ?: return
    safeEvalJs(
        mainWv,
        "(function(){" +
        "try{" +
        "if(window.__tpSnackbarFixed)return;" +
        "window.__tpSnackbarFixed=true;" +
        "var s=document.createElement('style');" +
        "s.id='tp-snackbar-style';" +
        "s.textContent='.snackbar,.toast,#toast,#snackbar,#snackbarContainer{z-index:2147483647!important;}';" +
        "(document.head||document.documentElement).appendChild(s);" +
        "}catch(e){}" +
        "})();"
    )
}

internal fun MainActivity.toggleDesktopMode() {
    val nativeWv = nativeWebViewOrNull() ?: return
    if (!isActivityAlive()) return
    try {
        isDesktopMode = !isDesktopMode
        val ua = if (isDesktopMode) desktopUserAgent else mobileUserAgent
        nativeWv.settings.userAgentString = ua
        nativeWv.settings.useWideViewPort = isDesktopMode
        nativeWv.settings.loadWithOverviewMode = isDesktopMode
        nativeWv.reload()
    } catch (_: Exception) {}
}

