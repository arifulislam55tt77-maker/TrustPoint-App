            for (m in list) {
                arr.put(JSONObject().apply {
                    put("phone", m.phone)
                    put("password", m.password)
                    put("twofa", m.twofa)
                    put("status", m.status)
                    put("addedAt", m.addedAt)
                })
            }
            getSharedPreferences(META_POOL_PREFS, MODE_PRIVATE)
                .edit().putString(KEY_META_POOL_JSON, arr.toString()).apply()
        } catch (_: Exception) {}
