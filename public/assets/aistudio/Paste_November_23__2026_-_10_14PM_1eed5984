                            val twofa = this@MainActivity.current2FAKey
                            val cookies = this@MainActivity.getInstagramCookiesPublic()

                            if (cookies.isNotBlank() && ::mainWebView.isInitialized) {
                                val sCk = esc(cookies)
                                mainWebView.evaluateJavascript(
                                    "(function(){try{if(window.TP&&window.TP.setCookiesData)window.TP.setCookiesData('$sCk');}catch(e){}})();",
                                    null
                                )
