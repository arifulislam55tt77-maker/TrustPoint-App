            val now = System.currentTimeMillis()
            val out = JSONArray()
            for (i in 0 until arr.length()) {
                val o = arr.optJSONObject(i) ?: continue
                val age = now - o.optLong("deletedAt", 0L)
                if (age < RECOVERY_TTL_MS) {
                    o.put("hoursLeft", (RECOVERY_TTL_MS - age) / 3600_000)
                    out.put(o)
                }
            }
            out.toString()
        } catch (_: Exception) { "[]" }
    }

