        @JavascriptInterface fun setNativeWebBounds(left: Float, top: Float, width: Float, height: Float) {
            this@MainActivity.runOnUiThread {
                if (this@MainActivity.isFinishing || this@MainActivity.isDestroyed || !::nativeWebView.isInitialized) return@runOnUiThread
                try {
                    if (this@MainActivity.uiOverlayActive || this@MainActivity.telegramPopupLocked) {
                        nativeWebView.visibility = View.INVISIBLE
                        return@runOnUiThread
                    }
                    val parent = nativeWebView.parent as? ViewGroup
                    parent?.clipChildren = true
                    parent?.clipToPadding = true

                    val refW = if (::mainWebView.isInitialized && mainWebView.width > 0) mainWebView.width
                    else (parent?.width ?: window.decorView.width)
                    val refH = if (::mainWebView.isInitialized && mainWebView.height > 0) mainWebView.height
                    else (parent?.height ?: window.decorView.height)
                    if (refW <= 0 || refH <= 0) return@runOnUiThread

                    val l = (left * refW).toInt().coerceIn(0, refW - 1)
                    val t = (top * refH).toInt().coerceIn(0, refH - 1)
                    val w = (width * refW).toInt().coerceAtLeast(1).coerceAtMost(refW - l)
                    val h = (height * refH).toInt().coerceAtLeast(1).coerceAtMost(refH - t)

                    val lp = FrameLayout.LayoutParams(w, h)
                    lp.leftMargin = l
                    lp.topMargin = t
                    nativeWebView.layoutParams = lp
                    nativeWebView.requestLayout()
                    this@MainActivity.bringTelegramFabToFront()
                } catch (_: Exception) {}
            }
        }

