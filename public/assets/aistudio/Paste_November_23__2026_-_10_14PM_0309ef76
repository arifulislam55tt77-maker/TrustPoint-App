<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#121212">
<title>TP</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<style>
html,body{background:#121212;}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;overflow:hidden;background:#121212;color:#eee;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;user-select:none;-webkit-user-select:none;}
input,textarea,select{user-select:text;-webkit-user-select:text}

.app{position:fixed;inset:0;width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden;background:#121212;z-index:1;}
.brandbar{flex:0 0 40px;height:40px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;background:#050505;color:#fff;font-size:14px;font-weight:900;letter-spacing:.3px;border-bottom:1px solid #222;}
.brandbar > span { flex: 1; }
.tp-brand-text { text-align: left; }
.brandbar-right{text-align: right; font-size:10px;color:#9ec5ff;font-weight:700;}
.brandbar-icons { display:flex; align-items:center; gap:8px; flex:0 0 auto; }
.brandbar-icons span { cursor:pointer; font-size:18px; padding: 0 4px; }

/* TOP GRID */
.top-grid{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(4, 38px);gap:3px;padding:0px 1px 2px 1px;background:#0d0f12;flex:0 0 auto;height:163px;overflow:hidden;}
.top-grid .tab{width:100%;min-width:0;border-radius:6px;font-size:13px;font-weight:900;padding:0 1px;color:#fff;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:transform .08s ease;position:relative;z-index:2;height:100%;line-height:1.1;text-shadow:0 1px 3px rgba(0,0,0,.8);border-width:2px;border-style:solid;display:flex;align-items:center;justify-content:center;gap:2px;}
.top-grid .tab:active{transform:translateY(2px);box-shadow:inset 0 2px 5px rgba(0,0,0,.75) !important;}
.top-grid .top1{background:linear-gradient(180deg,#4c1d95,#2e1065);border-color:#a78bfa;box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 3px 0 #1e1b4b, 0 4px 8px rgba(0,0,0,.5);}
.top-grid .top2{background:linear-gradient(180deg,#9a3412,#7c2d12);border-color:#fb923c;box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 3px 0 #431407, 0 4px 8px rgba(0,0,0,.5);}
.top-grid .top3{background:linear-gradient(180deg,#0f766e,#115e59);border-color:#2dd4bf;box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 3px 0 #042f2e, 0 4px 8px rgba(0,0,0,.5);}
.top-grid .top4{background:linear-gradient(180deg,#be185d,#9d174d);border-color:#f472b6;box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 3px 0 #500724, 0 4px 8px rgba(0,0,0,.5);}
.top-grid .top5{background:linear-gradient(180deg,#1d4ed8,#1e40af);border-color:#60a5fa;box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 3px 0 #172554, 0 4px 8px rgba(0,0,0,.5);}
.top-grid .top6{background:linear-gradient(180deg,#15803d,#166534);border-color:#4ade80;box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 3px 0 #052e16, 0 4px 8px rgba(0,0,0,.5);}
.top-grid .top7{background:linear-gradient(180deg,#b45309,#92400e);border-color:#fbbf24;box-shadow:inset 0 1px 0 rgba(255,255,255,.18), 0 3px 0 #451a03, 0 4px 8px rgba(0,0,0,.5);}

.content{flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;position:relative;}

.status{margin:0px 1px 2px 1px;background:#000;color:#fff;height:64px;padding:6px 8px;position:relative;border:1px solid #222;border-radius:6px;overflow:hidden;flex:0 0 64px;}
.status-info{position:absolute;left:8px;top:6px;right:120px;display:flex;flex-direction:column;gap:3px;max-width:100%;}
.status-info .line{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12.5px;font-weight:800;padding:3px 8px;border-radius:6px;text-shadow:0 1px 2px rgba(0,0,0,.6);border:2px solid;height:24px;line-height:16px;}
#dispCountry{background:linear-gradient(180deg,#0d3a45,#051a22);border-color:#22d3ee;color:#cffafe;}
#dispNumber{background:linear-gradient(180deg,#3a1d5c,#1a0a2e);border-color:#a855f7;color:#e9d5ff;cursor:pointer;}
.status-side{position:absolute;right:8px;top:6px;min-width:100px;width:100px;text-align:right;display:flex;flex-direction:column;gap:5px;align-items:flex-end;}
.status .otp{display:flex;align-items:center;justify-content:center;white-space:nowrap;color:#fecaca;font-weight:900;font-size:18px;padding:6px 10px;border-radius:6px;text-shadow:0 1px 2px rgba(0,0,0,.7);border:2px solid #ef4444;background:linear-gradient(180deg,#7f1d1d,#450a0a);box-shadow:inset 0 1px 0 rgba(255,255,255,.2), 0 3px 0 #2a0606, 0 0 10px rgba(239,68,68,.35);letter-spacing:1px;cursor:pointer;width:100%;height:48px;transition:transform .1s ease;}

.web-area{flex:1 1 auto;min-height:0;margin:0px 0 2px 0;background:#0b0d10;border-top:1px solid #232730;border-bottom:1px solid #232730;overflow:hidden;position:relative;z-index:1;}
.web-area iframe{position:absolute;inset:0;width:100%;height:100%;border:0;background:#121212;display:block;z-index:1;}
.web-loader{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;background:#121212;color:#8b93a3;font-size:13px;transition:opacity .15s ease;z-index:5;pointer-events:none;}
.web-loader.hide{opacity:0}
.web-loader .spin{width:26px;height:26px;border-radius:50%;border:3px solid #233042;border-top-color:#3b82f6;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}

.tg-sheet-backdrop{position:fixed;inset:0;z-index:2147483645;background:rgba(0,0,0,0.68);backdrop-filter:blur(2px);display:none;align-items:center;justify-content:center;padding:8px 6px;}
.tg-sheet-backdrop.open{display:flex;animation:tgSheetFade .15s ease-out;}
@keyframes tgSheetFade{from{opacity:0;}to{opacity:1;}}
.tg-sheet-panel{width:100%;max-width:600px;height:90vh;max-height:90vh;background:#0e1621;border:2px solid #38bdf8;border-radius:14px;box-shadow:0 16px 48px rgba(0,0,0,0.95), 0 0 0 1px rgba(56,189,248,0.25);display:flex;flex-direction:column;overflow:hidden;animation:tgSheetPop .18s cubic-bezier(0.22, 0.61, 0.36, 1);}
@keyframes tgSheetPop{from{transform:scale(0.96) translateY(12px);opacity:0.65;}to{transform:scale(1) translateY(0);opacity:1;}}
.tg-sheet-header{flex:0 0 46px;height:46px;background:#17212b;border-bottom:1px solid #263648;padding:0 10px 0 12px;display:flex;align-items:center;justify-content:space-between;gap:6px;}
.tg-sheet-title{display:flex;align-items:center;gap:7px;font-size:13.5px;font-weight:900;color:#fff;white-space:nowrap;}
.tg-sheet-title svg{width:18px;height:18px;fill:#2aabee;flex-shrink:0;}
.tg-sheet-actions{display:flex;align-items:center;gap:5px;flex-shrink:0;}
.tg-pill-btn{height:28px;padding:0 8px;border-radius:7px;border:1px solid #334155;background:#23303d;color:#f1f5f9;font-size:11px;font-weight:800;cursor:pointer;white-space:nowrap;}
.tg-pill-btn.active-on{background:#14532d;border-color:#22c55e;color:#dcfce7;}
.tg-pill-btn.active-off{background:#7f1d1d;border-color:#ef4444;color:#fecaca;}
.tg-pill-btn.locked-on{background:#78350f;border-color:#fbbf24;color:#fef3c7;}
.tg-sheet-close{width:28px;height:28px;border-radius:50%;border:1px solid #f87171;background:#dc2626;color:#fff;font-size:15px;font-weight:900;cursor:pointer;display:flex;align-items:center;justify-content:center;}

.tg-2fa-bar{flex:0 0 auto;background:#121b24;border-bottom:1px solid #243447;padding:7px 10px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
.tg-2fa-input{flex:1 1 150px;min-width:120px;height:32px;border:1px solid #334155;border-radius:7px;background:#0b1117;color:#f8fafc;padding:0 9px;font-size:12px;font-family:monospace;outline:none;}
.tg-2fa-btn{height:32px;padding:0 10px;border-radius:7px;border:1px solid #38bdf8;background:#0284c7;color:#fff;font-size:11.5px;font-weight:800;cursor:pointer;white-space:nowrap;}
.tg-2fa-btn.gen{background:#15803d;border-color:#4ade80;}

.tg-sheet-body{flex:1 1 auto;min-height:0;position:relative;background:#0e1621;}
.tg-web-frame{width:100%;height:100%;border:0;background:#0e1621;display:block;}
.tg-off-notice{position:absolute;inset:0;background:#0e1621;display:none;align-items:center;justify-content:center;flex-direction:column;gap:10px;padding:20px;text-align:center;color:#94a3b8;font-size:13px;z-index:5;}
.tg-off-notice.show{display:flex;}

.bottom{flex:0 0 auto;min-height:46px;display:flex;gap:4px;padding:4px 4px calc(6px + env(safe-area-inset-bottom)) 4px;background:#24272b;border-top:1px solid #333;position:relative;z-index:25;}
.bottom button{flex:1;min-width:0;height:38px;border-radius:5px;font-size:12px;font-weight:800;padding:0 3px;white-space:nowrap;cursor:pointer;overflow:hidden;text-overflow:ellipsis;text-shadow:0 1px 2px rgba(0,0,0,.6);color:#fff;border-width:2px;border-style:solid;transition:transform .08s ease;}
.bottom button:active{transform:translateY(2px);box-shadow:inset 0 2px 5px rgba(0,0,0,.75) !important;}
.bottom1{background:linear-gradient(180deg,#1e3a8a,#0e1e4a);border-color:#3b82f6;}
.bottom2{background:linear-gradient(180deg,#14532d,#052e16);border-color:#22c55e;}
.bottom3{background:linear-gradient(180deg,#78350f,#3a1a06);border-color:#f59e0b;}
.bottom4{background:linear-gradient(180deg,#7f1d1d,#450a0a);border-color:#ef4444;}

.overlay{display:block;position:fixed;inset:0;background:rgba(0,0,0,.72);z-index:2147483640;opacity:0;pointer-events:none;transition:opacity .14s ease;touch-action:none;}
.overlay.open{opacity:1;pointer-events:auto;}
.overlay.open.closing{opacity:0;pointer-events:none;}
.drawer{position:fixed;z-index:2147483641;top:0;bottom:0;left:0;width:82vw;max-width:400px;background:linear-gradient(180deg,#101114 0%,#0a0b0d 100%);border-right:2px solid #334155;overflow-y:auto;padding:max(14px, env(safe-area-inset-top)) 12px max(18px, env(safe-area-inset-bottom));-webkit-overflow-scrolling:touch;transform:translate3d(-100%,0,0);transition:transform .16s cubic-bezier(.22,.61,.36,1);box-shadow:8px 0 30px rgba(0,0,0,.85);will-change:transform;}
.drawer.open{transform:translate3d(0,0,0);}
.drawer.open.closing{transform:translate3d(-100%,0,0);}
body.drawer-open{overflow:hidden !important;}
.close{float:right;background:#1e293b;border:1px solid rgba(255,255,255,.35);color:#fff;font-size:18px;border-radius:50%;width:30px;height:30px;line-height:26px;cursor:pointer;}
.drawer-brand{color:#fff;font-size:18px;font-weight:900;letter-spacing:.5px;}
.drawer-subtitle{color:#a6adba;font-size:12px;margin-top:2px;font-weight:600;}

.menu-settings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-top:12px}
.menu-settings button{min-height:42px;padding:6px 4px;border:2px solid #fff;border-radius:8px;background:#171a20;color:#fff;font-size:12px;font-weight:800;cursor:pointer;transition:transform .06s ease;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center;justify-content:center;box-shadow: inset 0 1px 0 rgba(255,255,255,0.2), 0 3px 0 rgba(0,0,0,0.5);}
.menu-settings button:active{opacity:.8;transform:translateY(2px);box-shadow:none;}
.menu-settings button:nth-child(1){border-color:#3b82f6;background:#1e3a8a;}
.menu-settings button:nth-child(2){border-color:#fbbf24;background:#78350f;}
.menu-settings button:nth-child(3){border-color:#c084fc;background:#4c1d95;}
.menu-settings button:nth-child(4){border-color:#f472b6;background:#831843;}
.menu-settings button:nth-child(5){border-color:#fb923c;background:#7c2d12;}
.menu-settings button:nth-child(6){border-color:#38bdf8;background:#0c4a6e;}
.menu-settings button:nth-child(7){border-color:#34d399;background:#064e3b;}
.menu-settings button:nth-child(8){border-color:#ef4444;background:#7f1d1d;}
.menu-settings button:nth-child(9){border-color:#22c55e;background:#14532d;}
.menu-settings button:nth-child(10){border-color:#eab308;background:#713f12;}

.menu-settings button.admin-btn{border-color:#06b6d4;background:#164e63;color:#a5f3fc;}
.menu-settings button.meta-toggle-btn{border-color:#10b981;background:#064e3b;color:#6ee7b7;}
.menu-settings button.meta-toggle-btn.on{border-color:#fbbf24;background:#78350f;color:#fde68a;}
.menu-settings button.set-meta-btn{border-color:#d97706;background:#451a03;color:#fde68a;}
.menu-settings button.join-channel-btn{border-color:#38bdf8;background:linear-gradient(135deg,#229ed9,#1677c8);color:#fff;grid-column: 1 / -1;font-size: 14px;font-weight: 900;}

.modal-backdrop{display:none;position:fixed;inset:0;z-index:2147483646;background:rgba(0,0,0,.78);align-items:center;justify-content:center;padding:10px;}
.modal-backdrop.open{display:flex}
.mini-modal{position:relative;width:min(440px,95vw);max-height:92vh;display:flex;flex-direction:column;background:#161920;border:1px solid #334155;border-radius:16px;color:#fff;box-shadow:0 20px 60px #000;overflow:hidden;animation:modalPop .14s ease-out;z-index:2147483646;}
@keyframes modalPop{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}
.mini-modal h3{margin:16px 40px 10px 16px;font-size:19px;font-weight:900;color:#f1f5f9;flex-shrink:0;}
.modal-close{position:absolute;right:12px;top:12px;width:30px;height:30px;border-radius:50%;border:1px solid #475569;background:#1e293b;color:#cbd5e1;font-size:18px;line-height:26px;cursor:pointer;z-index:5;display:flex;align-items:center;justify-content:center;}
#modalBody{flex:1 1 auto;overflow-y:auto;padding:0 16px 12px 16px; -webkit-overflow-scrolling: touch;}
.modal-actions{display:flex;gap:8px;padding:10px 16px 16px 16px;flex-wrap:wrap;flex-shrink:0;}
.modal-actions button{flex:1;min-width:80px;min-height:42px;border:1px solid #475569;border-radius:10px;background:#262f3d;color:#fff;font-weight:800;cursor:pointer;font-size:14px;}
.modal-actions button:active{transform:scale(0.97)}
.modal-actions .modal-primary{background:#16a34a;border-color:#22c55e;}
.modal-actions .modal-blue-full{background:#2563eb;border-color:#3b82f6;font-size:15px;box-shadow:0 4px 12px rgba(37,99,235,.4);}
.modal-label{display:block;color:#aeb8c4;font-size:13px;margin:8px 0 4px;font-weight:bold;}
.modal-input,.modal-textarea{width:100%;border:1px solid #46515e;border-radius:8px;background:#20252c;color:#fff;padding:10px;font-size:14px;outline:none;}
.modal-textarea{height:110px;resize:none;font-family:monospace;font-size:12px;line-height:1.5}
.modal-note{color:#aeb8c4;line-height:1.45;margin:6px 0;font-size:12px}

.mini-modal.large-modal{width:min(820px, 96vw) !important;max-height:94vh !important;background:#14171f !important;border:1px solid #2d3748 !important;}

.sd-stats-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px;}
.sd-stat-box{border-radius:12px;padding:12px 8px;text-align:center;color:#fff;box-shadow:0 4px 12px rgba(0,0,0,.35);}
.sd-stat-blue{background:linear-gradient(180deg,#2563eb,#1d4ed8);border:1px solid #60a5fa;}
.sd-stat-green{background:linear-gradient(180deg,#16a34a,#15803d);border:1px solid #4ade80;}
.sd-stat-label{font-size:11px;font-weight:800;letter-spacing:.8px;opacity:.9;text-transform:uppercase;}
.sd-stat-val{font-size:24px;font-weight:900;margin-top:2px;line-height:1.1;}
.sd-list{display:flex;flex-direction:column;gap:10px;max-height:54vh;overflow-y:auto;padding-right:2px;}
.sd-card{background:#181c24;border:1px solid #334155;border-radius:12px;padding:12px;}
.sd-data-line{font-family:monospace;font-size:12.5px;line-height:1.55;color:#e2e8f0;word-break:break-all;margin-bottom:10px;}
.sd-idx{color:#60a5fa;font-weight:900;}
.sd-btns{display:flex;justify-content:flex-end;gap:7px;flex-wrap:wrap;}
.sd-btn{border:none;border-radius:7px;padding:6px 11px;font-size:12px;font-weight:800;color:#fff;cursor:pointer;display:inline-flex;align-items:center;gap:4px;}
.sd-btn:active{transform:scale(.95);}
.sd-btn-login{background:#22c55e;color:#052e16;}
.sd-btn-copy{background:#2563eb;}
.sd-btn-del{background:#dc2626;}

.rm-badge{position:absolute;right:48px;top:14px;background:#0c2d48;border:1px solid #0284c7;color:#38bdf8;font-size:12px;font-weight:800;padding:3px 10px;border-radius:20px;}
.rm-selected-banner{background:#092918;border:1px solid #16a34a;color:#4ade80;padding:8px 12px;border-radius:9px;font-size:13px;font-weight:800;margin-bottom:8px;display:flex;align-items:center;gap:6px;}
.rm-sub-bar{background:#1d2536;border:1px solid #2e3b55;color:#93c5fd;text-align:center;padding:7px;border-radius:8px;font-size:12px;font-weight:900;letter-spacing:1.2px;margin:8px 0 10px 0;}
.rm-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding:2px 0 6px;max-height:54vh;overflow-y:auto;}
.rm-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;padding:11px 4px;border:1px solid #2e3646;border-radius:11px;background:#1b202b;cursor:pointer;color:#e5e7eb;transition:transform .08s;text-align:center;min-width:0;}
.rm-card:active{background:#243044;border-color:#60a5fa;transform:scale(.96)}
.rm-card.selected{border-color:#22c55e;background:#0f2a1c;border-width:2px;}
.rm-flag{font-size:22px;line-height:1;}
.rm-code{font-size:12.5px;font-weight:900;color:#f8fafc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;}
.rm-country{font-size:11px;color:#94a3b8;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;line-height:1.1;}

.sm-list{display:flex;flex-direction:column;gap:8px;margin-top:6px;}
.sm-option{display:flex;align-items:center;gap:10px;padding:12px 10px;border:2px solid #334155;border-radius:10px;background:#1a1e26;cursor:pointer;}
.sm-option.selected{border-color:#22c55e;background:#0f2a1c;}
.sm-icon{font-size:24px;flex:0 0 auto;}
.sm-body{flex:1;min-width:0;}
.sm-title{font-size:13.5px;font-weight:900;color:#e5e7eb;margin-bottom:2px;}
.sm-desc{font-size:11.5px;color:#94a3b8;}
.sm-check{font-size:20px;color:#22c55e;font-weight:900;}

.otp-hist-item{background:#1a1f29;border:1px solid #334155;border-radius:10px;padding:10px 12px;margin-bottom:8px;display:flex;align-items:center;justify-content:space-between;gap:8px;}
.otp-hist-code{font-size:17px;font-weight:900;color:#4ade80;letter-spacing:1px;}
.otp-hist-meta{font-size:11.5px;color:#94a3b8;margin-top:2px;}

.ua-list { display: flex; flex-direction: column; gap: 6px; padding: 10px; }
.ua-option { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #1e2025; border: 1px solid #334155; border-radius: 8px; cursor: pointer; color: #e2e8f0; font-size: 14px; transition: background 0.1s; }
.ua-option:active { background: #2a2e35; }
.ua-option.active { border-color: #3b82f6; background: #1e3a8a; }
.ua-radio { width: 18px; height: 18px; border-radius: 50%; border: 2px solid #64748b; display: flex; align-items: center; justify-content: center; }
.ua-option.active .ua-radio { border-color: #60a5fa; }
.ua-option.active .ua-radio::after { content: ''; width: 10px; height: 10px; border-radius: 50%; background: #60a5fa; }

.toast{position:fixed;left:50%;top:44px;transform:translate(-50%,-6px);z-index:2147483647;background:#f2f4f7;color:#172033;padding:5px 14px;border-radius:14px;font-size:11.5px;font-weight:800;opacity:0;pointer-events:none;transition:.14s ease;box-shadow:0 3px 10px rgba(0,0,0,.45);white-space:nowrap;max-width:85vw;overflow:hidden;text-overflow:ellipsis;border:1.5px solid #2563eb;}
.toast.show{opacity:1;transform:translate(-50%,0)}
.toast.warn{background:#fef3c7;border-color:#f59e0b;color:#78350f}
.toast.ok{background:#dcfce7;border-color:#16a34a;color:#14532d}
.toast.err{background:#fee2e2;border-color:#ef4444;color:#7f1d1d}

#bootSplash{position:fixed;inset:0;z-index:2147483647;background:#121212;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;}
#bootSplash .boot-spin{width:44px;height:44px;border:3px solid #222;border-top-color:#60a5fa;border-radius:50%;animation:bootspin 0.8s linear infinite;}
#bootSplash .boot-text{color:#555;font-size:12px;font-weight:600;letter-spacing:2px;}
@keyframes bootspin{to{transform:rotate(360deg)}}
#bootSplash.hide{opacity:0;pointer-events:none;transition:opacity 0.2s ease;}
</style>
</head>
<body>

