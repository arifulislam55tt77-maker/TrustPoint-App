            closeModal();
        }},
        { text: "Cancel", onClick: closeModal }
      ]);
    }, 170);
  };

  $("liveCheckerBtn").onclick = function () {
    closeDrawer(true);
    showToast("📡 Starting live check…");
    var ret = Bridge.call("startLiveCheck");
    if (!ret) showToast("Live checker unavailable", "warn");
  };

  $("clearWebTopBtn").onclick = function () {
    try {
      if (mainFrame && mainFrame.style.display !== "none") mainFrame.src = "about:blank";
      Bridge.call("clearWebInstant");
      loadUrl(HOME_URL);
      setTimeout(function () {
        applyOverlayLockState();
        syncWebAreaBounds();
      }, 150);
    } catch (e) {}
    showToast("🧹 Web cleared", "ok");
  };

  window.TP.showToast  = showToast;
  window.TP.openModal  = showModal;
  window.TP.closeModal = closeModal;

})();
</script>

</body>
</html>
