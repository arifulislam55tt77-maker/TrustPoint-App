<script>
(function () {
  "use strict";

  window.TP = window.TP || {};

  function safeJsonParse(raw, fallback) {
    try {
      if (!raw || typeof raw !== "string") return fallback;
      var t = raw.trim();
      if (!t) return fallback;
      return JSON.parse(t);
    } catch (e) {
      return fallback;
    }
  }

  function cleanupRemovedFloatingButtons() {
    try {
      var strayIds = ["__ir_copy_user_btn", "tgFixedFab", "tgSecondFab", "telegramFab2", "tgFloatingBtn2"];
      strayIds.forEach(function (id) {
        var el = document.getElementById(id);
        if (el && el.parentNode) el.parentNode.removeChild(el);
      });
      document.querySelectorAll("[data-tg-fab='true'], .tg-fixed-fab, .tg-extra-fab, .tg-second-fab").forEach(function (el) {
        if (el && el.parentNode) el.parentNode.removeChild(el);
      });
    } catch (e) {}
  }
  cleanupRemovedFloatingButtons();

  window.hideBootSplash = function () {
    try {
      var s = document.getElementById("bootSplash");
      if (!s) return;
      s.classList.add("hide");
      setTimeout(function () { try { s.remove(); } catch (e) { s.style.display = "none"; } }, 220);
    } catch (e) {}
  };
  setTimeout(function () { try { window.hideBootSplash(); } catch (e) {} }, 4000);

  var buildTime = new Date();
  try {
    document.getElementById("lastUpdate").textContent = buildTime.toLocaleDateString() + " " + buildTime.toLocaleTimeString();
    document.getElementById("appVersion").textContent = "1.2." + Math.floor(buildTime.getTime() / 1000000000);
  } catch (e) {}

  var creatorName = "『Raj』Chowdhury☬";
  document.addEventListener("DOMContentLoaded", function () {
    cleanupRemovedFloatingButtons();
    document.querySelectorAll(".tp-creator-text").forEach(function (el) { el.textContent = creatorName; });
  });

  var Bridge = {
    has: function () {
      try {
        return (typeof window.Android !== "undefined" && window.Android !== null) ||
               (typeof window.SheetAPI !== "undefined" && window.SheetAPI !== null);
      } catch (e) { return false; }
    },
    call: function (name) {
      var args = Array.prototype.slice.call(arguments, 1);
      try {
        if (typeof window.SheetAPI !== "undefined" && window.SheetAPI && typeof window.SheetAPI[name] === "function") {
          return window.SheetAPI[name].apply(window.SheetAPI, args);
        }
      } catch (e) {}
      try {
        if (typeof window.Android !== "undefined" && window.Android && typeof window.Android[name] === "function") {
          return window.Android[name].apply(window.Android, args);
        }
      } catch (e) {}
      return null;
    }
  };

  function getSheetBridge() {
    try { if (typeof window.SheetAPI !== "undefined" && window.SheetAPI !== null) return window.SheetAPI; } catch (e) {}
    try { if (typeof window.Android !== "undefined" && window.Android !== null) return window.Android; } catch (e) {}
    return null;
  }

  var HOME_URL = "https://www.instagram.com/accounts/login/?mtn";
  var LOGIN_URL = "https://www.instagram.com/accounts/login/?mtn";
  var TWOFA_URL = "https://accountscenter.instagram.com/password_and_security/two_factor/?theme=dark";
  var $ = function (id) { return document.getElementById(id); };
  var drawer = $("drawer"), overlay = $("overlay");
  var modalBackdrop = $("modalBackdrop"), uaModalBackdrop = $("uaModalBackdrop"), miniModal = $("miniModal"),
      modalTitle = $("modalTitle"), modalBody = $("modalBody"),
      modalActions = $("modalActions"), modalBadge = $("modalBadge"), toastEl = $("toast");
  var mainFrame = $("mainFrame"), webArea = $("webArea"), bottomBar = $("bottomBar");
  var dispCountry = $("dispCountry"), dispNumber = $("dispNumber"), dispOtp = $("dispOtp");
  var hUid = $("webUid"), hPass = $("webPass"), hCookies = $("webCookies"), hMail = $("webHotmail"), h2FA = $("web2FA"), hUsername = $("webUsername");

  var currentNumber = "", currentCountry = "", currentUrl = HOME_URL, lastSavedPassword = "";

  function isLikelyPhoneOrAccountToken(tok) {
    if (!tok) return false;
    var t = tok.trim();
    if (t.charAt(0) === "+") return true;
    var digits = t.replace(/[^0-9]/g, "");
    if (digits.length >= 8 && /^[+0-9()\-]+$/.test(t)) return true;
    if (t.indexOf("@") > 0) return true;
    return false;
  }

  function parseMetaLineSmart(rawLine, statusMap) {
    var trimmed = (rawLine || "").trim();
    if (!trimmed) return null;

    var tokens = trimmed.split(/[|,:;\t\s]+/).map(function (t) { return t.trim(); }).filter(Boolean);
    if (tokens.length < 2) return null;

    var phoneIdx = tokens.findIndex(isLikelyPhoneOrAccountToken);
    var phone = "";
    var password = "";
    var twofa = "";

    if (phoneIdx === 0) {
      phone = tokens[0];
      password = tokens[1] || "";
      twofa = tokens.slice(2).join("");
    } else if (phoneIdx > 0) {
      password = tokens.slice(0, phoneIdx).join(" ");
      phone = tokens[phoneIdx];
      twofa = tokens.slice(phoneIdx + 1).join("");
    } else {
      password = tokens[0];
      phone = tokens[1];
      twofa = tokens.slice(2).join("");
    }

    if (!phone || !password) return null;

    return {
      phone: phone,
      password: password,
      twofa: twofa,
      status: (statusMap && statusMap[phone]) ? statusMap[phone] : "fresh",
      addedAt: Date.now()
    };
  }

  function formatMetaLineDisplay(m) {
    var pass = m.password || "";
    var phone = m.phone || "";
    var twofa = m.twofa || "";
    return [pass, phone, twofa].filter(Boolean).join(" ");
  }

  function getStoredMetaPool() {
    var nativeList = [];
    try {
      var raw = Bridge.call("getMetaListNative") || Bridge.call("getMetaList");
      var parsedNative = safeJsonParse(raw, []);
      if (Array.isArray(parsedNative)) nativeList = parsedNative;
    } catch (e) {}

    var localList = safeJsonParse(localStorage.getItem("tp_meta_pool"), []);
    var source = (Array.isArray(nativeList) && nativeList.length > 0) ? nativeList : (Array.isArray(localList) ? localList : []);

    return source.map(function (m) {
      if (!m) return null;
      if (m.phone && m.password) {
        return {
          phone: String(m.phone).trim(),
          password: String(m.password).trim(),
          twofa: String(m.twofa || "").trim(),
          status: m.status || "fresh",
          addedAt: m.addedAt || Date.now()
        };
      }
      var combined = [m.phone || "", m.password || "", m.twofa || ""].join(" ");
      return parseMetaLineSmart(combined, null);
    }).filter(Boolean);
  }

  function saveStoredMetaPool(poolList) {
    var clean = Array.isArray(poolList) ? poolList : [];
    try { localStorage.setItem("tp_meta_pool", JSON.stringify(clean)); } catch (e) {}
    try { Bridge.call("saveMetaPoolJsonNative", JSON.stringify(clean)); } catch (e) {}
  }

  function applyActiveMetaToState(acc) {
    if (!acc) return;
    var phone = (acc.phone || "").trim();
    var pass = (acc.password || "").trim();
    var twofa = (acc.twofa || "").trim();

    if (phone) {
      currentNumber = phone;
      if (dispNumber) dispNumber.textContent = "Number: " + phone;
      try { localStorage.setItem("tp_active_meta_phone", phone); } catch (e) {}
    }
    if (pass) {
      lastSavedPassword = pass;
      try {
        localStorage.setItem("tp_password", pass);
        localStorage.setItem("tp_active_meta_pass", pass);
      } catch (e) {}
      if (hPass) hPass.value = pass;
      try { Bridge.call("savePassword", pass); } catch (e) {}
    }
    if (twofa) {
      try {
        localStorage.setItem("tp_last_2fa_key", twofa);
        localStorage.setItem("tp_active_meta_2fa", twofa);
      } catch (e) {}
      if (h2FA) h2FA.value = twofa;
      try { Bridge.call("set2FAKey", twofa); } catch (e) {}
    }
  }

  function consumeNextFreshMetaAccount() {
    var pool = getStoredMetaPool();
    var idx = pool.findIndex(function (m) { return (m.status || "fresh") === "fresh"; });

    if (idx !== -1) {
      var chosen = pool[idx];
      pool[idx].status = "used";
      saveStoredMetaPool(pool);
      try { Bridge.call("markMetaUsedNative", chosen.phone); } catch (e) {}
      applyActiveMetaToState(chosen);
      return chosen;
    }

    try {
      var rawFresh = Bridge.call("getMeta");
      var obj = safeJsonParse(rawFresh, null);
      if (obj && obj.phone && obj.password) {
        applyActiveMetaToState(obj);
        return obj;
      }
    } catch (e) {}

    return null;
  }

  /* TELEGRAM OVERLAY */
  var telegramTaskEnabled = localStorage.getItem("tp_tg_task_enabled") !== "false";
  var telegramSheetLocked = localStorage.getItem("tp_tg_sheet_locked") === "true";
  var TG_WEB_K = "https://web.telegram.org/k/";
  var TG_WEB_A = "https://web.telegram.org/a/";
  var activeTgUrl = localStorage.getItem("tp_tg_web_url") || TG_WEB_K;

  function updateTelegramVerLabel() {
    var titleEl = $("tgPanelTitleText");
    var verBtn = $("tgPanelVerBtn");
    var isK = (activeTgUrl || "").indexOf("/k/") !== -1;
    if (titleEl) titleEl.textContent = isK ? "Telegram Login (K)" : "Telegram Login (A)";
    if (verBtn) verBtn.textContent = isK ? "K / A" : "A / K";
  }

  function loadTelegramLoginFrame(targetUrl) {
    var tgFrame = $("tgLoginFrame");
    if (!tgFrame) return;
    var urlToLoad = targetUrl || activeTgUrl || TG_WEB_K;
    activeTgUrl = urlToLoad;
    try { localStorage.setItem("tp_tg_web_url", activeTgUrl); } catch (e) {}
    updateTelegramVerLabel();

    try { Bridge.call("setTelegramWebUrl", urlToLoad); } catch (e) {}
    try { Bridge.call("loadTelegramPopupUrl", urlToLoad); } catch (e) {}
    try { tgFrame.setAttribute("src", urlToLoad); } catch (e) {}
  }

  function syncTelegramPowerState(enabled) {
    telegramTaskEnabled = !!enabled;
    try { localStorage.setItem("tp_tg_task_enabled", String(telegramTaskEnabled)); } catch (e) {}

    var panelPowerBtn = $("tgPanelPowerBtn");
    var offNotice = $("tgOffNotice");
    var tgFrame = $("tgLoginFrame");

    if (panelPowerBtn) {
      panelPowerBtn.textContent = telegramTaskEnabled ? "ON" : "OFF";
      panelPowerBtn.classList.toggle("active-on", telegramTaskEnabled);
      panelPowerBtn.classList.toggle("active-off", !telegramTaskEnabled);
    }
    if (offNotice) offNotice.classList.toggle("show", !telegramTaskEnabled);
    if (tgFrame) {
      if (telegramTaskEnabled) {
        var curSrc = tgFrame.getAttribute("src") || "";
        if (!curSrc || curSrc === "about:blank") loadTelegramLoginFrame(activeTgUrl);
      } else {
        try { tgFrame.setAttribute("src", "about:blank"); } catch (e) {}
      }
    }

    cleanupRemovedFloatingButtons();
    try { Bridge.call("setTelegramTaskEnabled", telegramTaskEnabled); } catch (e) {}
  }

  function syncTelegramSheetLock(locked) {
    telegramSheetLocked = !!locked;
    try { localStorage.setItem("tp_tg_sheet_locked", String(telegramSheetLocked)); } catch (e) {}
    var backdrop = $("tgSheetBackdrop");
    var lockBtn = $("tgPanelLockBtn");
    if (backdrop) backdrop.classList.toggle("locked", telegramSheetLocked);
    if (lockBtn) {
      lockBtn.textContent = telegramSheetLocked ? "🔓 Unlock" : "🔒 Lock";
      lockBtn.classList.toggle("locked-on", telegramSheetLocked);
    }
    try { Bridge.call("setTelegramLocked", telegramSheetLocked); } catch (e) {}
